root = true

[*.py]
indent_style = space
indent_size = 4
insert_final_newline = true
charset = utf-8
# EditorConfig helps maintain consistent coding styles for multiple developers working on the same project
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
