###############################################
# Exemple de configuration d'environnement    #
# Copier ce fichier en `.env` et renseigner   #
# vos valeurs locales (ne JAMAIS committer).  #
###############################################

# --- Mode / Scheduler ---
CRYPTO_MONITOR_MODE=scheduler
ENABLE_SCHEDULER=1
SCHEDULER_CONFIG=scheduler/jobs.yaml
RUN_JOBS_AT_START=1
SCHEDULER_JITTER_PERCENT=10
HEARTBEAT_SECS=60

# --- Observabilité ---
ENABLE_METRICS=1
METRICS_PORT=9300
ENABLE_HEALTH=1
HEALTH_PORT=9310
API_HOST=127.0.0.1
API_PORT=8000
API_WRITE_KEY=
API_RATE_LIMIT_PER_MIN=60
# Doc interactive & OpenAPI (désactiver en prod si nécessaire)
API_DOCS_ENABLED=1
# Limites et cache lecture (optionnel)
# Limiter la taille des corps POST/PUT/PATCH (0 = désactivé)
API_MAX_BODY_BYTES=0
# Activer ETag + Cache-Control sur endpoints GET (0 = désactivé)
API_READ_MAX_AGE=0
# Exposer /metrics sur l'app principale (0 = off, 1 = on)
API_METRICS_ROUTE=0
# LLM stream SSE ne nécessite pas de variables additionnelles; protégé par X-API-KEY comme les autres POST.

# Optional LLM providers (configure one or more; API falls back to mock otherwise)
# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_DAILY_LIMIT=500

# OpenRouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/auto
# OPENROUTER_DAILY_LIMIT=500

# Ollama (local)
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1
# OLLAMA_DAILY_LIMIT=10000

# --- Build metadata (optionnel) ---
APP_VERSION=
GIT_SHA=
RUN_ID=

# --- Circuit Breaker (optionnel) ---
CB_THRESHOLD=3
CB_COOLDOWN_SECONDS=30

# --- Clés API (laisser vide si non utilisées) ---
CMC_API_KEY=
ETHERSCAN_API_KEY=
BINANCE_API_KEY=
BYBIT_API_KEY=
COINGECKO_API_KEY=
DUNE_API_KEY=
INFURA_API_KEY=
BITQUERY_API_KEY=
CRYPTOCOMPARE_API_KEY=
TOKEN_METRICS_API_KEY=

# --- Paramètres Dune (exemple, adapter) ---
DUNE_METRICS_MODE=wide
DUNE_BTC_WIDE_QUERY_ID=
DUNE_EXECUTE_ON_CACHE_MISS=true
DUNE_QUERY_TIMEOUT=120
DUNE_LOG_ROWS=true
DUNE_GRANULARITY=day
DUNE_START_DATE=
DUNE_END_DATE=
DUNE_LOOKBACK_DAYS=7

# NOTE: Gardez ce fichier générique. Toute valeur réelle saisie dans `.env` DOIT
# rester hors du contrôle de version. Vérifiez que `.env` figure dans `.gitignore`.
