{
  "dashboard": {
    "id": null,
    "title": "Crypto Signals Production Dashboard",
    "tags": ["crypto", "signals", "production"],
    "timezone": "UTC",
    "panels": [
      {
        "id": 1,
        "title": "System Health Overview",
        "type": "stat",
        "targets": [
          {
            "expr": "up{job=\"crypto-prodsafe\"}",
            "legendFormat": "Service Status"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "options": {
                  "0": {
                    "text": "DOWN",
                    "color": "red"
                  },
                  "1": {
                    "text": "UP",
                    "color": "green"
                  }
                },
                "type": "value"
              }
            ]
          }
        }
      },
      {
        "id": 2,
        "title": "Signal Processing Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(signals_received_total[5m])",
            "legendFormat": "Signals/sec"
          },
          {
            "expr": "rate(signals_validated_total[5m])",
            "legendFormat": "Validated/sec"
          }
        ]
      },
      {
        "id": 3,
        "title": "ML Model Performance",
        "type": "bargauge",
        "targets": [
          {
            "expr": "ml_confidence_histogram_sum / ml_confidence_histogram_count",
            "legendFormat": "Avg Confidence"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "orange",
                  "value": 0.7
                },
                {
                  "color": "green",
                  "value": 0.85
                }
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Drift Detection",
        "type": "graph",
        "targets": [
          {
            "expr": "drift_kl_divergence",
            "legendFormat": "{{feature}} KL Divergence"
          },
          {
            "expr": "rate(drift_alerts_total[5m]) * 300",
            "legendFormat": "Drift Alerts/min"
          }
        ]
      },
      {
        "id": 5,
        "title": "Batch Predictor Performance",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(batch_predictions_total[5m])",
            "legendFormat": "Batch Predictions/sec"
          },
          {
            "expr": "batch_cache_hit_rate",
            "legendFormat": "Cache Hit Rate"
          },
          {
            "expr": "batch_avg_processing_time_ms",
            "legendFormat": "Avg Processing Time (ms)"
          }
        ]
      },
      {
        "id": 6,
        "title": "Circuit Breaker Status",
        "type": "table",
        "targets": [
          {
            "expr": "circuit_breaker_state",
            "legendFormat": "{{name}}"
          }
        ]
      },
      {
        "id": 7,
        "title": "Error Rate Trends",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(signals_received_total{status=\"rejected\"}[5m]) / rate(signals_received_total[5m])",
            "legendFormat": "Rejection Rate"
          },
          {
            "expr": "rate(signals_received_total{status=\"telegram_failed\"}[5m])",
            "legendFormat": "Telegram Failures/sec"
          }
        ]
      },
      {
        "id": 8,
        "title": "Resource Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "process_resident_memory_bytes{job=\"crypto-prodsafe\"} / 1024 / 1024",
            "legendFormat": "Memory Usage (MB)"
          },
          {
            "expr": "rate(process_cpu_user_seconds_total{job=\"crypto-prodsafe\"}[5m]) * 100",
            "legendFormat": "CPU Usage (%)"
          }
        ]
      },
      {
        "id": 9,
        "title": "Redis Cache Performance",
        "type": "stat",
        "targets": [
          {
            "expr": "redis_connected_clients",
            "legendFormat": "Connected Clients"
          },
          {
            "expr": "redis_keyspace_hits_total / (redis_keyspace_hits_total + redis_keyspace_misses_total)",
            "legendFormat": "Cache Hit Rate"
          }
        ]
      },
      {
        "id": 10,
        "title": "Signal Latency Distribution",
        "type": "heatmap",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(signals_processing_duration_bucket[5m]))",
            "legendFormat": "95th percentile"
          }
        ]
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {},
    "templating": {
      "list": []
    },
    "annotations": {
      "list": [
        {
          "builtIn": 1,
          "datasource": "-- Grafana --",
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "type": "dashboard"
        }
      ]
    },
    "refresh": "30s",
    "schemaVersion": 27,
    "version": 0,
    "links": []
  }
}
