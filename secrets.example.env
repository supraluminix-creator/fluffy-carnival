# Example environment variables (no real secrets, replace placeholders)

# HTTP facade / retries
RETRY_HTTP_ENABLED=1
RETRY_HTTP_MAX=3
RETRY_HTTP_BACKOFF_BASE=0.3
RETRY_MAX_CUMULATIVE_SLEEP_SEC=12

# Throttling (requests per minute per provider, 0 to disable)
HTTP_THROTTLE_PER_MIN_DEFAULT=0
HTTP_THROTTLE_MAX_WAIT=8

# Feature flags
ENABLE_MVRV_COLLECTOR=0
ENABLE_MACRO_INDICES=0
FORCE_HTTP_FACADE=0
DRY_RUN_FACADE=0

# API keys (optional)
CMC_API_KEY=REPLACE_ME
COINMARKETCAP_API_KEY=REPLACE_ME
ETHERSCAN_API_KEY=REPLACE_ME
BGEOMETRICS_API_KEY=REPLACE_ME
BGEOMETRICS_VERIFY_SSL=1

# AI providers (optional)
OLLAMA_HOST=http://127.0.0.1:11434
OPENROUTER_API_KEY=REPLACE_ME
OPENROUTER_MODEL=openrouter/auto
HUGGINGFACE_API_KEY=REPLACE_ME
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
AI_PRIMARY=openrouter

# Export
EXPORT_DIR=exports
RUN_ID=local
