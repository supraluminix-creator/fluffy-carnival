# Example environment variables (placeholders)

# HTTP facade / retries
RETRY_HTTP_ENABLED=1
RETRY_HTTP_MAX=3
RETRY_HTTP_BACKOFF_BASE=0.3
RETRY_MAX_CUMULATIVE_SLEEP_SEC=0

# Feature flags
ENABLE_MVRV_COLLECTOR=0
ENABLE_MACRO_INDICES=0
FORCE_HTTP_FACADE=0
DRY_RUN_FACADE=0

# API keys (optional)
CMC_API_KEY=replace_me
COINMARKETCAP_API_KEY=replace_me
ETHERSCAN_API_KEY=replace_me
BGEOMETRICS_API_KEY=replace_me

# AI providers (optional)
OLLAMA_HOST=http://127.0.0.1:11434
OPENROUTER_API_KEY=replace_me
OPENROUTER_MODEL=openrouter/auto
HUGGINGFACE_API_KEY=replace_me
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
AI_PRIMARY=openrouter

# Export
EXPORT_DIR=exports
RUN_ID=
