# --- Dune ---
# Clé API Dune (obligatoire pour lire le cache et, si vous l'autorisez, exécuter)
DUNE_API_KEY=qGrt29CHodOi4gWSs7HlgDetgiXue7V8

DUNE_METRICS_MODE=wide
DUNE_BTC_WIDE_QUERY_ID=2899930
DUNE_EXECUTE_ON_CACHE_MISS=true
DUNE_QUERY_TIMEOUT=120          # total, en secondes (attente max)
DUNE_LOG_ROWS=true 
DUNE_GRANULARITY=day
DUNE_START_DATE=2025-09-01     # ex : 6 jours d’historique
DUNE_END_DATE=                 # vide = aujourd’hui
DUNE_LOOKBACK_DAYS=7           # si START non défini, prendra 7 jours


# --- Autres APIs (optionnelles) ---

# --- Scheduler Configuration ---
# Intervalles des collectors en secondes
COLLECTOR_INTERVAL_MARKET=300        # 5min - CoinGecko/CMC
COLLECTOR_INTERVAL_DEFILLAMA=900     # 15min - DeFi TVL
COLLECTOR_INTERVAL_ONCHAIN=1800      # 30min - Bitcoin metrics
COLLECTOR_INTERVAL_DERIVATIVES=300   # 5min - Bybit OI/FR
COLLECTOR_INTERVAL_SENTIMENT=3600    # 1h - Fear & Greed

# Jitter anti-rate-limit (pourcentage)
SCHEDULER_JITTER_PERCENT=10

