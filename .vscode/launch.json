{
  // Debugger configuration: ensure PYTHONPATH includes workspace
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder};${env:PYTHONPATH}"
      },
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Python: main.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder};${env:PYTHONPATH}"
      },
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
