{
  // Make the workspace root importable and recognized by Pylance
  "python.analysis.extraPaths": [
    "${workspaceFolder}"
  ],
  // Ensure Python extension adds workspace to PYTHONPATH for terminals/debugger
  "python.envFile": "${workspaceFolder}/.env",
  // Optional: if using tests/imports from subfolders
  "terminal.integrated.env.windows": {
    "PYTHONPATH": "${workspaceFolder};${env:PYTHONPATH}"
  }
}
